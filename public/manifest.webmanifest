{
  "id": "/",
  "name": "TaskNest",
  "short_name": "TaskNest",
  "description": "Goal-based roadmap manager: turn ambitions into milestones, tasks, and daily action.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#f7f5f0",
