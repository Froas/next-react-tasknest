      "icons": [{ "src": "/icons/tasknest-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "description": "Open the calendar",
      "url": "/calendar",
      "icons": [{ "src": "/icons/tasknest-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Notes",
      "short_name": "Notes",
      "description": "Open notes and quick capture",
      "url": "/notes",
      "icons": [{ "src": "/icons/tasknest-192.png", "sizes": "192x192" }]
    }
  ]
}
